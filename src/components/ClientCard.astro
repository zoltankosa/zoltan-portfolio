---
import Gallery from "./Gallery.astro";
import type { ManifestClient } from "../lib/manifest";

interface Props {
  slug: string;
  client: ManifestClient;
  href?: string;
}
const { slug, client, href } = Astro.props;
const labels = client.items.map((i) => i.label);
---
<div class="card">
  <Gallery slug={slug} labels={labels} alt={client.name} />
  <div class="meta">
    <h3>
      {href ? (
        <a href={href}>{client.name}<span class="arrow"> &rarr;</span></a>
      ) : (
        client.name
      )}
    </h3>
    <p class="eyebrow">{client.sector}</p>
    <p class="line">{client.line}</p>
  </div>
</div>

<style>
  .card { min-width: 0; }
  .meta { padding-block-start: 18px; }
  h3 { margin-block-end: 6px; }
  h3 a { text-decoration: none; }
  .arrow { color: var(--ink); }
  .eyebrow { margin-block-end: 10px; }
  .line { color: var(--muted); max-width: 60ch; }
</style>
