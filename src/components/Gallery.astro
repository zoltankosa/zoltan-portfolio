---
import { Image, getImage } from "astro:assets";
import { getRawImage } from "../lib/images";

interface Props {
  slug: string;
  labels: string[];
  alt: string;
  ratio?: string;
}
const { slug, labels, alt, ratio = "16 / 9" } = Astro.props;

const [mainLabel] = labels;
const mainImg = mainLabel ? getRawImage(slug, mainLabel) : undefined;

const lightboxImages = await Promise.all(
  labels.map(async (label) => {
    const raw = getRawImage(slug, label);
    if (!raw) return null;
    const full = await getImage({ src: raw, width: Math.min(2400, raw.width) });
    const tall = raw.height / raw.width > 1.8;
    return { src: full.src, alt: `${alt} — ${label}`, tall };
  })
);
const galleryData = JSON.stringify(lightboxImages.filter(Boolean));
---
<div class="gallery" data-gallery data-images={galleryData}>
  <button class="main" style={`aspect-ratio: ${ratio}`} data-lightbox-open data-index="0" aria-label={`Open ${alt} gallery`}>
    {mainImg && (
      <Image src={mainImg} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 860px) 60vw, 100vw" loading="eager" />
    )}
  </button>
</div>

<style>
  .gallery { display: block; }
  .main {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: var(--ink);
    overflow: hidden;
    cursor: zoom-in;
  }
  .main :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
</style>
