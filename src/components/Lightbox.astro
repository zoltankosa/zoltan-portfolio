<div id="lightbox" class="lightbox" hidden>
  <button class="lb-close" data-lb-close aria-label="Close">&times;</button>
  <button class="lb-prev" data-lb-prev aria-label="Previous image">&larr;</button>
  <div class="lb-track" data-lb-track></div>
  <button class="lb-next" data-lb-next aria-label="Next image">&rarr;</button>
  <p class="lb-count" data-lb-count></p>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(15, 15, 15, 0.96);
    z-index: 100;
  }
  .lightbox[hidden] { display: none; }

  .lb-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .lb-track::-webkit-scrollbar { display: none; }
  .lb-track :global(.lb-slide) {
    flex: 0 0 100%;
    scroll-snap-align: center;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 56px;
    box-sizing: border-box;
  }
  .lb-track :global(.lb-slide img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }
  .lb-track :global(.lb-slide.tall) {
    display: block;
    overflow-y: auto;
    padding: 0;
  }
  .lb-track :global(.lb-slide.tall img) {
    max-width: none;
    max-height: none;
    width: 100%;
    height: auto;
    display: block;
  }
  .lb-close, .lb-prev, .lb-next {
    position: absolute;
    background: none;
    border: none;
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    z-index: 101;
    padding: 16px;
    font-family: var(--font-display);
  }
  .lb-close { top: 4px; right: 4px; font-size: 32px; }
  .lb-prev, .lb-next {
    background: var(--ink);
    border: none;
    padding: 20px;
  }
  .lb-prev { left: 4px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 4px; top: 50%; transform: translateY(-50%); }
  .lb-close:hover, .lb-prev:hover, .lb-next:hover { opacity: 0.7; }

  .lb-count {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.08em;
    z-index: 101;
    margin: 0;
  }

  @media (max-width: 640px) {
    .lightbox {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      grid-template-rows: 1fr auto auto;
      grid-template-areas:
        "track track track"
        "prev  close next"
        "count count count";
    }
    .lb-close {
      position: static;
      grid-area: close;
      justify-self: center;
      padding: 14px 24px;
    }
    .lb-track {
      grid-area: track;
      min-height: 0;
    }
    .lb-track :global(.lb-slide) { padding: 16px 0; }
    .lb-track :global(.lb-slide.tall) { padding: 0; }
    .lb-prev, .lb-next {
      position: static;
      padding: 14px 24px;
      font-size: 20px;
    }
    .lb-prev { grid-area: prev; justify-self: start; }
    .lb-next { grid-area: next; justify-self: end; }
    .lb-count {
      position: static;
      grid-area: count;
      justify-self: center;
      transform: none;
      padding-block-end: 12px;
    }
  }
</style>

<script>
  type LightboxImage = { src: string; alt: string; tall?: boolean };

  let images: LightboxImage[] = [];
  let current = 0;

  const lb = document.getElementById("lightbox") as HTMLElement;
  const track = lb.querySelector("[data-lb-track]") as HTMLElement;
  const countEl = lb.querySelector("[data-lb-count]") as HTMLElement;

  function renderTrack() {
    track.innerHTML = "";
    for (const img of images) {
      const slide = document.createElement("div");
      slide.className = img.tall ? "lb-slide tall" : "lb-slide";
      const el = document.createElement("img");
      el.src = img.src;
      el.alt = img.alt;
      slide.appendChild(el);
      track.appendChild(slide);
    }
  }

  function updateCount() {
    countEl.textContent = images.length > 1 ? `${current + 1} / ${images.length}` : "";
  }

  function goTo(index: number, smooth = true) {
    if (images.length === 0) return;
    current = Math.max(0, Math.min(images.length - 1, index));
    const target = track.children[current] as HTMLElement | undefined;
    target?.scrollIntoView({ behavior: smooth ? "smooth" : "auto", inline: "center", block: "nearest" });
    updateCount();
  }

  function open(data: LightboxImage[], index: number) {
    if (!data.length) return;
    images = data;
    renderTrack();
    lb.hidden = false;
    document.body.style.overflow = "hidden";
    goTo(index, false);
  }

  function close() {
    lb.hidden = true;
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    const trigger = target.closest<HTMLElement>("[data-lightbox-open]");
    if (trigger) {
      const gallery = trigger.closest<HTMLElement>("[data-gallery]");
      if (!gallery) return;
      let data: LightboxImage[] = [];
      try {
        data = JSON.parse(gallery.dataset.images || "[]");
      } catch {
        data = [];
      }
      open(data, Number(trigger.dataset.index || 0));
      return;
    }

    if (!lb.hidden) {
      if (target.closest("[data-lb-close]") || target === lb) close();
      else if (target.closest("[data-lb-prev]")) goTo(current - 1);
      else if (target.closest("[data-lb-next]")) goTo(current + 1);
    }
  });

  document.addEventListener("keydown", (e) => {
    if (lb.hidden) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowLeft") goTo(current - 1);
    else if (e.key === "ArrowRight") goTo(current + 1);
  });

  let scrollTimer: ReturnType<typeof setTimeout>;
  track.addEventListener(
    "scroll",
    () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const idx = Math.round(track.scrollLeft / track.clientWidth);
        if (idx !== current && idx >= 0 && idx < images.length) {
          current = idx;
          updateCount();
        }
      }, 100);
    },
    { passive: true }
  );
</script>
